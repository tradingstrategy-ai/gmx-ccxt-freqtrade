{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "datadir": "user_data/data",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 10,
    "stake_currency": "USDC",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "timeframe": "1h",
    "trading_fees": {
        "entry": 0.0007,
        "exit": 0.0007
    },
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60,
        "stoploss_on_exchange_limit_ratio": 0.99,
        "entry_timeout_unfilled_order_method": "market",
        "exit_timeout_unfilled_order_method": "market"
    },
    "exchange": {
        "name": "gmx",
        "ccxt_config": {
            "enableRateLimit": true,
            "rateLimit": 500,
            "executionBuffer": 2.1
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 500
        },
        "pair_whitelist": [
            "0G/USDC:USDC",
            "AAVE/USDC:USDC",
            "ADA/USDC:USDC",
            "APE/USDC:USDC",
            "APT/USDC:USDC",
            "ARB/USDC:USDC",
            "ASTER/USDC:USDC",
            "ATOM/USDC:USDC",
            "AVAX/USDC:USDC",
            "BCH/USDC:USDC",
            "BNB/USDC:USDC",
            "BTC/USDC:USDC",
            "CAKE/USDC:USDC",
            "CRV/USDC:USDC",
            "DOGE/USDC:USDC",
            "DOT/USDC:USDC",
            "ENA/USDC:USDC",
            "ETH/USDC:USDC",
            "FARTCOIN/USDC:USDC",
            "GMX/USDC:USDC",
            "HYPE/USDC:USDC",
            "INJ/USDC:USDC",
            "LDO/USDC:USDC",
            "LINEA/USDC:USDC",
            "LINK/USDC:USDC",
            "LTC/USDC:USDC",
            "MKR/USDC:USDC",
            "MOODENG/USDC:USDC",
            "NEAR/USDC:USDC",
            "ONDO/USDC:USDC",
            "OP/USDC:USDC",
            "PENDLE/USDC:USDC",
            "PENGU/USDC:USDC",
            "PEPE/USDC:USDC",
            "POL/USDC:USDC",
            "PUMP/USDC:USDC",
            "SEI/USDC:USDC",
            "SHIB/USDC:USDC",
            "SOL/USDC:USDC",
            "SUI/USDC:USDC",
            "TAO/USDC:USDC",
            "TON/USDC:USDC",
            "TRUMP/USDC:USDC",
            "TRX/USDC:USDC",
            "UNI/USDC:USDC",
            "WIF/USDC:USDC",
            "WLFI/USDC:USDC",
            "WLD/USDC:USDC",
            "XLM/USDC:USDC",
            "XPL/USDC:USDC",
            "XRP/USDC:USDC",
            "ZORA/USDC:USDC"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "bot_name": "ichiv2-ls-gmx-backtest-all",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 15
    }
}

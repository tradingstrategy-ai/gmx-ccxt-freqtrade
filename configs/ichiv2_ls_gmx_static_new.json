{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 10,
    "stake_currency": "USDC",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": false,
    "dry_run_wallet": 100,
    "timeframe": "1h",
    "coingecko": {
        "api_key": "",
        "is_demo": false
    },
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60,
        "stoploss_on_exchange_limit_ratio": 0.99,
        "entry_timeout_unfilled_order_method": "market",
        "exit_timeout_unfilled_order_method": "market"
    },
    "exchange": {
        "name": "gmx",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true,
            "rateLimit": 500,
            "executionBuffer": 2.1
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 500
        },
        "pair_whitelist": [
            "AAVE/USDC:USDC",
            "APE/USDC:USDC",
            "APT/USDC:USDC",
            "ARB/USDC:USDC",
            "ATOM/USDC:USDC",
            "AVAX/USDC:USDC",
            "BNB/USDC:USDC",
            "BOME/USDC:USDC",
            "BTC/USDC:USDC",
            "CRV/USDC:USDC",
            "DOGE/USDC:USDC",
            "ETH/USDC:USDC",
            "FLOKI/USDC:USDC",
            "GMX/USDC:USDC",
            "LDO/USDC:USDC",
            "LINK/USDC:USDC",
            "LTC/USDC:USDC",
            "MEME/USDC:USDC",
            "MEW/USDC:USDC",
            "MKR/USDC:USDC",
            "NEAR/USDC:USDC",
            "OP/USDC:USDC",
            "PENDLE/USDC:USDC",
            "PEPE/USDC:USDC",
            "POL/USDC:USDC",
            "SEI/USDC:USDC",
            "SHIB/USDC:USDC",
            "SOL/USDC:USDC",
            "TAO/USDC:USDC",
            "UNI/USDC:USDC",
            "WIF/USDC:USDC",
            "XRP/USDC:USDC"
        ],
        "pair_blacklist": [
            ""
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "bot_name": "ichiv2-ls-gmx-static-new",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 15
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "CORS_origins": []
    },
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": "",
        "allow_custom_messages": true,
        "notification_settings": {
            "status": "silent",
            "warning": "on",
            "startup": "off",
            "entry": "silent",
            "entry_fill": "on",
            "entry_cancel": "silent",
            "exit": {
                "roi": "silent",
                "emergency_exit": "on",
                "force_exit": "on",
                "exit_signal": "silent",
                "trailing_stop_loss": "on",
                "stop_loss": "on",
                "stoploss_on_exchange": "on",
                "custom_exit": "on",
                "partial_exit": "on",
                "*": "off"
            },
            "exit_cancel": "on",
            "exit_fill": "on",
            "protection_trigger": "off",
            "protection_trigger_global": "on",
            "strategy_msg": "off",
            "show_candle": "off"
        },
        "reload": true,
        "balance_dust_level": 0.01,
        "keyboard": [
            [
                "/daily",
                "/profit",
                "/balance"
            ],
            [
                "/status",
                "/status table",
                "/performance"
            ],
            [
                "/count",
                "/logs",
                "/help"
            ]
        ]
    }
}
# GMX data collection (make gmx-data)
# Copy to .env and fill in your values

# Required: Arbitrum RPC URL (Alchemy, Infura, QuickNode, etc.)
JSON_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Required: HyperSync API token (free from https://envio.dev)
HYPERSYNC_API_TOKEN=your_hypersync_token_here
